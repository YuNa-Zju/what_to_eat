[Unit]
Description=今天吃什么
After=network.target

[Service]
Type=simple
User=what-to-eat
Group=what-to-eat
WorkingDirectory=/srv/what-to-eat
Environment=BIND_ADDR=127.0.0.1:3000
Environment=STATIC_DIR=/srv/what-to-eat/public
Environment=DATA_DIR=/srv/what-to-eat/data
Environment=COOKIE_SECURE=true
Environment=RUST_LOG=what_to_eat=info,tower_http=info
ExecStart=/srv/what-to-eat/what-to-eat
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/what-to-eat/data

[Install]
WantedBy=multi-user.target
